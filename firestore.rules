rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات المستخدم: يقرأ ويكتب حسابه فقط.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // أكواد التفعيل.
    // تحذير أمني: التحقق يتم حالياً من طرف العميل، لذا لا يمكن منع العميل من
    // قراءة الكود. هذه القواعد تقيّد الوصول للمستخدمين المسجّلين وتمنع إنشاء أو
    // حذف الأكواد من التطبيق (يتم إنشاؤها من لوحة التحكم فقط).
    // للحماية الكاملة: انقل التحقق إلى Cloud Function واجعل هذه المجموعة
    // مرفوضة بالكامل من العميل (allow: if false).
    match /activation_codes/{code} {
      allow read: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.used == true;
      allow create, delete: if false;
    }

    // أي مسار آخر: مرفوض افتراضياً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
